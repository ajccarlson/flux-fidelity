{
  "manifest_version": 3,
  "name": "FSRCNNX/ArtCNN \u2014 Real-time Video Upscaler",
  "version": "0.49.0",
  "description": "Real-time FSRCNNX/ArtCNN luma upscaling + SSimDownscaler + adaptive sharpen for non-DRM web video via WebGPU.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FSRCNNX",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fsrcnnx-main.js",
        "fsrcnnx-runtime.js",
        "fsrcnnx-color.js",
        "model/*.wgsl",
        "model/*.json",
        "validate.html",
        "fsrcnnx-ssimds.js",
        "fsrcnnx-ssimds-runtime.js",
        "fsrcnnx-sharpen.js",
        "fsrcnnx-artcnn-runtime.js",
        "model/*.artcnn.wgsl",
        "model/*.artcnn.json",
        "fsrcnnx-deband.js",
        "icons/icon-off-16.png",
        "icons/icon-off-32.png",
        "icons/icon-off-48.png",
        "icons/icon-off-128.png",
        "fsrcnnx-images.js",
        "fsrcnnx-interpolate.js",
        "fsrcnnx-rife.js",
        "vendor/ort/*",
        "model/*.onnx",
        "fsrcnnx-grab.js",
        "fsrcnnx-rife-gpu.js",
        "fsrcnnx-neural.js",
        "model/neural/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}