root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown uses trailing whitespace for hard line breaks.
trim_trailing_whitespace = false

[*.{onnx,wasm,png,rgb16le}]
# Binary artifacts are hash-pinned; editors must not normalize them.
insert_final_newline = false
trim_trailing_whitespace = false
