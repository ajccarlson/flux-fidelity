{
  "name": "flux-fidelity",
  "version": "0.50.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "description": "Real-time WebGPU video upscaling and frame interpolation for Chromium",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajccarlson/fsrcnnx-ext.git"
  },
  "bugs": {
    "url": "https://github.com/ajccarlson/fsrcnnx-ext/issues"
  },
  "homepage": "https://github.com/ajccarlson/fsrcnnx-ext#readme",
  "scripts": {
    "check": "npm run check:syntax && npm run check:package && npm run check:models && npm run check:generated && npm run check:references && npm run check:browser-fixtures && npm run check:release-record && npm run check:cda-feasibility && npm test",
    "check:syntax": "node --experimental-vm-modules --no-warnings tools/check-syntax.mjs",
    "check:package": "node tools/check-package.mjs",
    "check:models": "node tools/check-models.mjs",
    "check:generated": "node tools/check-generated.mjs",
    "check:references": "node tools/check-reference-fixtures.mjs",
    "check:browser-fixtures": "node tools/check-browser-fixtures.mjs",
    "check:release-record": "node tools/check-release-clearance.mjs --record-only",
    "check:rife-reproduction": "sh tools/model-reproduction/check-rife-fp16.sh",
    "check:cda-feasibility": "python -B -m unittest discover -s tools/cda-vsr -p \"test_*.py\"",
    "validate:browser": "node tools/browser-validation.mjs",
    "probe:cda-browser": "node tools/cda-vsr/browser_probe.mjs",
    "fetch:shader-sources": "node tools/fetch-shader-sources.mjs",
    "reference:generate": "node tools/generate-reference-fixtures.mjs",
    "reference:check": "node tools/check-reference-fixtures.mjs",
    "browser-fixtures:generate": "node tools/generate-browser-fixtures.mjs --write",
    "package:stage": "node tools/build-package.mjs",
    "package:internal": "npm run check && npm run package:stage",
    "package": "npm run release:check",
    "release:check": "npm run check && node tools/check-release-clearance.mjs && npm run package:stage && npm run validate:browser -- --extension-root dist/flux-fidelity --neural-model-key cda-vsr-4x --require-temporal-neural-runs",
    "test": "node --test tests/*.test.mjs"
  }
}
