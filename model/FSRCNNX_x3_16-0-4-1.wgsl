  { let s_RES4_1_1 = textureLoad(t_RES4, clampCoord(p + vec2i(1, 1), textureDimensions(t_RES4)), 0);
    res[0] += dot(vec4f(0.0194056574, 0.000234631312, 0.0163144171, 0.00958990585), s_RES4_1_1);
    res[1] += dot(vec4f(0.0355427787, 0.0129752681, 0.0249147080, -0.00592643349), s_RES4_1_1);
    res[2] += dot(vec4f(0.0406190716, -0.000297692983, 0.0267004687, -0.0183448531), s_RES4_1_1);
  }
  textureStore(outTex, p, res);
}

//==== ENTRY pass27 : aggregation ====
// ---- PASS 27: aggregation (save=null, comps=1) ----
// binds: SUBCONV1, SUBCONV2, SUBCONV3
// pixel-shuffle aggregation, scale=3, 3 subconv texture(s)
@group(0) @binding(0) var src0 : texture_2d<f32>;
@group(0) @binding(1) var src1 : texture_2d<f32>;
@group(0) @binding(2) var src2 : texture_2d<f32>;
@group(0) @binding(3) var outTex : texture_storage_2d<rgba16float, write>;
@compute @workgroup_size(8, 8)
fn main(@builtin(global_invocation_id) gid : vec3u) {
  let dims = textureDimensions(outTex);
  if (gid.x >= dims.x || gid.y >= dims.y) { return; }
  let lo = vec2i(i32(gid.x) / 3, i32(gid.y) / 3);
  let ix = i32(gid.x) % 3;
  let iy = i32(gid.y) % 3;
  var cols : array<vec4f, 3>;
  cols[0] = textureLoad(src0, lo, 0);
  cols[1] = textureLoad(src1, lo, 0);
  cols[2] = textureLoad(src2, lo, 0);
  let col = cols[ix];
  var y = col.x;
  if (iy == 1) { y = col[1]; }
  if (iy == 2) { y = col[2]; }
  textureStore(outTex, vec2i(i32(gid.x), i32(gid.y)), vec4f(y, 0.0, 0.0, 1.0));
}
