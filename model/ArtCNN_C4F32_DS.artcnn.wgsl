  let t = textureLoad(t_conv2d_6, sp, 0);
  let ch = i0.y * 2 + i0.x;
  var v = t.x;
  if (ch == 1) { v = t.y; }
  if (ch == 2) { v = t.z; }
  if (ch == 3) { v = t.w; }
  textureStore(outTex, vec2i(i32(gid.x), i32(gid.y)), vec4f(clamp(v, 0.0, 1.0), 0.0, 0.0, 1.0));
}
